# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/gitinsight

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# GitHub API Configuration (Optional Personal Access Token for increased rate limits: 5,000 req/hr vs 60 req/hr)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
